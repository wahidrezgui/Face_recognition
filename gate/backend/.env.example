APP_NAME="Gate Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gate.local

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gate
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=

# See config/sanctum.php — include your SPA host (e.g. gate.local)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,gate.local,127.0.0.1

# Optional Keycloak SSO (password login stays available). Full notes: .env.keycloak.example
KEYCLOAK_ENABLED=false
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=gate
KEYCLOAK_CLIENT_ID=gate-bff
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=
KEYCLOAK_SCOPES="openid profile email"
KEYCLOAK_FEDERATED_LOGOUT=true
KEYCLOAK_PROMPT=login
KEYCLOAK_VERIFY_ID_TOKEN=true
KEYCLOAK_ID_TOKEN_LEEWAY=60
KEYCLOAK_JWKS_CACHE_TTL=3600
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=

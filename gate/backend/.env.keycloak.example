# Keycloak SSO (optional — password login remains the default)
KEYCLOAK_ENABLED=false
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=gate
KEYCLOAK_CLIENT_ID=gate-bff
KEYCLOAK_CLIENT_SECRET=
# Optional override. Defaults to ${APP_URL}/api/auth/keycloak/callback
KEYCLOAK_REDIRECT_URI=
KEYCLOAK_SCOPES="openid profile email"
KEYCLOAK_FEDERATED_LOGOUT=true
KEYCLOAK_PROMPT=login
KEYCLOAK_VERIFY_ID_TOKEN=true
KEYCLOAK_ID_TOKEN_LEEWAY=60
KEYCLOAK_JWKS_CACHE_TTL=3600
# Optional override. Defaults to ${APP_URL}/
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=

# Admin activation workflow:
# 1) User signs in via Keycloak → user stub is created with keycloak_pending_sub (server-side only)
# 2) User sees /auth/pending and contacts admin
# 3) Admin opens user in All Users, ticks "تفعيل حساب مرسال", assigns role + department, saves
# 4) User signs in again via Keycloak
